{
  "name": "ewe-apps",
  "private": true,
  "version": "0.1.1-beta",
  "license": "GPL-3.0-only",
  "description": "ewe Files, ewe Player and ewe Viewer — the first-party apps of the ewe desktop",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "tauri:files": "pnpm --filter ewe-files-app tauri",
    "tauri:player": "pnpm --filter ewe-player tauri",
    "tauri:viewer": "pnpm --filter ewe-viewer tauri",
    "icons": "bash scripts/gen-icons.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
